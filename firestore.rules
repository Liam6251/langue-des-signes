rules_version = '2';
// Chaque compte ne peut lire et écrire que sa propre progression : progres/{son identifiant}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /progres/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['etat', 'maj', 'xp'])
        && request.resource.data.etat is string
        && request.resource.data.etat.size() < 900000;
    }
    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
